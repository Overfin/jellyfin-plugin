<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Overfin.Jellyfin</AssemblyName>
    <RootNamespace>Overfin.Jellyfin</RootNamespace>
    <!-- The plugin's version: the one Overfin pins. -->
    <Version>0.2.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Jellyfin's own, at the version of the Jellyfin it's built for;
         Jellyfin provides them at run time. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Overfin.Jellyfin.Tests" />
  </ItemGroup>
</Project>
